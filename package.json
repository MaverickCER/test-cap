{
  "name": "test-cap",
  "version": "0.0.0",
  "private": true,
  "description": "Internal authentication package for MaverickCER apps.",
  "keywords": [],
  "homepage": "https://github.com/MaverickCER/test-cap#readme",
  "bugs": {
    "url": "https://github.com/MaverickCER/test-cap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaverickCER/test-cap.git"
  },
  "license": "MIT",
  "author": {
    "name": "MaverickCER",
    "url": "https://github.com/MaverickCER"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fetch": {
      "import": {
        "types": "./dist/fetch.d.ts",
        "default": "./dist/fetch.js"
      },
      "require": {
        "types": "./dist/fetch.d.cts",
        "default": "./dist/fetch.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./tanstack-start": {
      "import": {
        "types": "./dist/tanstack-start.d.ts",
        "default": "./dist/tanstack-start.js"
      },
      "require": {
        "types": "./dist/tanstack-start.d.cts",
        "default": "./dist/tanstack-start.cjs"
      }
    },
    "./store/memory": {
      "import": {
        "types": "./dist/store/memory.d.ts",
        "default": "./dist/store/memory.js"
      },
      "require": {
        "types": "./dist/store/memory.d.cts",
        "default": "./dist/store/memory.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "/*.md",
    "specs",
    "src/env.schema.ts",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsup && tsc -p tsconfig.build.json && node scripts/emit-dts-shims.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"test/{property,attacks,cross-runtime}/**\"",
    "test:property": "vitest run test/property",
    "test:attacks": "vitest run test/attacks",
    "test:cross-runtime": "npm run build && node test/cross-runtime/run.mjs",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:api": "typedoc",
    "docs:api:report": "typedoc --options typedoc.markdown.json",
    "docs:env": "internal-package-contract env",
    "docs:openapi": "vitest run test/docs/openapi.test.ts --update",
    "docs:storybook": "storybook build --quiet --output-dir storybook-static",
    "storybook": "storybook dev --port 6006",
    "size": "internal-package-contract tool size",
    "contract": "internal-package-contract",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts && npm run build && internal-package-contract update-baseline",
    "release": "changeset publish",
    "benchmark": "node node_modules/internal-package-contract/scripts/benchmark/run-suite.mjs benchmarks/performance-runtime/suite.mjs",
    "benchmark:check": "node node_modules/internal-package-contract/scripts/benchmark/run-suite.mjs benchmarks/performance-runtime/suite.mjs --check",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:coverage",
    "prepublishOnly": "npm run verify"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@electric-sql/pglite": "0.5.16",
    "@maverickcer/env-cap": "^0.7.7",
    "@storybook/html-vite": "10.6.5",
    "@tanstack/react-start": "1.169.5",
    "@testing-library/dom": "10.4.2",
    "@types/express": "5.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "4.13.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "10.1.8",
    "express": "5.3.0",
    "fast-check": "4.10.2",
    "internal-package-contract": "github:MaverickCER/internal-package-contract#ab0f846d7927f63ad5d77c72e4de55de87ec543c",
    "jsdom": "30.1.3",
    "prettier": "3.9.9",
    "storybook": "10.6.5",
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "8.3.8",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "internal-package-contract": {
    "copies": [
      "benchmark-budgets",
      "code-of-conduct",
      "editorconfig",
      "reading-benchmarks",
      "releasing",
      "support",
      "typedoc-markdown",
      "writing-benchmarks"
    ],
    "apiTargets": {
      "./express": "src/adapters/express/index.ts",
      "./fetch": "src/adapters/fetch/index.ts",
      "./next": "src/adapters/next/index.ts",
      "./tanstack-start": "src/adapters/tanstack-start/index.ts",
      "./store/memory": "src/store/memory.ts"
    }
  },
  "overrides": {
    "adm-zip": "0.6.1"
  },
  "envCap": {
    "schema": "./src/env.schema.ts"
  },
  "peerDependencies": {
    "@maverickcer/env-cap": "^0.7.7"
  },
  "peerDependenciesMeta": {
    "@maverickcer/env-cap": {
      "optional": true
    }
  },
  "dependencies": {
    "hash-wasm": "^4.13.0"
  }
}
