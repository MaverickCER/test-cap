exports[`the SQL each dialect sends (pinned, so a change to any statement is a reviewed change) > prints the schema for each dialect 1`] = `
{
  "mysql": "CREATE TABLE IF NOT EXISTS test_cap_records (id BIGINT AUTO_INCREMENT PRIMARY KEY, tenant VARCHAR(255) NOT NULL, collection VARCHAR(255) NOT NULL, record_key VARCHAR(255) NOT NULL, owner VARCHAR(255) NULL, version BIGINT NOT NULL, expires_at BIGINT NULL, revoked_at BIGINT NULL, consumed_at BIGINT NULL, data LONGTEXT NOT NULL, UNIQUE (tenant, collection, record_key), INDEX test_cap_records_owner (tenant, collection, owner)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE IF NOT EXISTS test_cap_counters (tenant VARCHAR(255) NOT NULL, counter VARCHAR(255) NOT NULL, hits BIGINT NOT NULL, window_start BIGINT NOT NULL, reset_at BIGINT NOT NULL, PRIMARY KEY (tenant, counter)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;
CREATE TABLE IF NOT EXISTS test_cap_audit (tenant VARCHAR(255) NOT NULL, stream VARCHAR(255) NOT NULL, seq BIGINT NOT NULL, record LONGTEXT NOT NULL, PRIMARY KEY (tenant, stream, seq)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;",
  "postgres": "CREATE TABLE IF NOT EXISTS test_cap_records (id BIGINT GENERATED ALWAYS AS IDENTITY PRIMARY KEY, tenant TEXT NOT NULL, collection TEXT NOT NULL, record_key TEXT NOT NULL, owner TEXT NULL, version BIGINT NOT NULL, expires_at BIGINT NULL, revoked_at BIGINT NULL, consumed_at BIGINT NULL, data TEXT NOT NULL, UNIQUE (tenant, collection, record_key));
CREATE INDEX IF NOT EXISTS test_cap_records_owner ON test_cap_records (tenant, collection, owner);
CREATE TABLE IF NOT EXISTS test_cap_counters (tenant TEXT NOT NULL, counter TEXT NOT NULL, hits BIGINT NOT NULL, window_start BIGINT NOT NULL, reset_at BIGINT NOT NULL, PRIMARY KEY (tenant, counter));
CREATE TABLE IF NOT EXISTS test_cap_audit (tenant TEXT NOT NULL, stream TEXT NOT NULL, seq BIGINT NOT NULL, record TEXT NOT NULL, PRIMARY KEY (tenant, stream, seq));",
  "sqlite": "CREATE TABLE IF NOT EXISTS test_cap_records (id INTEGER PRIMARY KEY AUTOINCREMENT, tenant TEXT NOT NULL, collection TEXT NOT NULL, record_key TEXT NOT NULL, owner TEXT NULL, version BIGINT NOT NULL, expires_at BIGINT NULL, revoked_at BIGINT NULL, consumed_at BIGINT NULL, data TEXT NOT NULL, UNIQUE (tenant, collection, record_key));
CREATE INDEX IF NOT EXISTS test_cap_records_owner ON test_cap_records (tenant, collection, owner);
CREATE TABLE IF NOT EXISTS test_cap_counters (tenant TEXT NOT NULL, counter TEXT NOT NULL, hits BIGINT NOT NULL, window_start BIGINT NOT NULL, reset_at BIGINT NOT NULL, PRIMARY KEY (tenant, counter));
CREATE TABLE IF NOT EXISTS test_cap_audit (tenant TEXT NOT NULL, stream TEXT NOT NULL, seq BIGINT NOT NULL, record TEXT NOT NULL, PRIMARY KEY (tenant, stream, seq));",
}
`;
